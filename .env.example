# NTU Dataset Download Credentials
# Copy this file to .env and fill in your actual credentials
# You can get these from your NTU account at https://rose1.ntu.edu.sg/

NTU_USERNAME=your_username_here
NTU_PASSWORD=your_password_here

# Optional: Download directory (defaults to /net/polaris/storage/deeplearning/ntu)
# NTU_DOWNLOAD_DIR=/path/to/download/directory
